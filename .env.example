# One container: radio247. Copy this file to .env before first startup.
# Compose loads this file through env_file; application values are not duplicated in YAML.
# Start: docker compose up --build -d
# Recreate containers after env changes; restart alone does not reload env.

# Container identity / total resource limits. Rebuild after changing UID/GID.
RADIO247_UID=1000
RADIO247_GID=1000
RADIO247_CPUS=2.0
RADIO247_MEMORY_LIMIT=1g
RADIO247_PIDS_LIMIT=128
RADIO247_TMP_SIZE=256m
RADIO247_STOP_GRACE_PERIOD=30s

# Host publishing address. Use your NAS LAN IP for LAN access; not a public IP.
RADIO247_HOST_BIND=127.0.0.1
RADIO247_HOST_PORT=8000
# Container listener; normally leave BIND_HOST at 0.0.0.0.
RADIO247_BIND_HOST=0.0.0.0
RADIO247_WEB_PORT=8000
# Empty derives http://127.0.0.1:<WEB_PORT>. Both processes are in one container.
RADIO247_INTERNAL_API_URL=

# Host folders are ./media, ./images, ./cache, ./data, ./output and ./runtime.
# Create them beside compose.yaml and grant UID:GID write access before startup.
# Container paths below stay inside those fixed bind mounts.
RADIO247_MEDIA_DIR=/media
RADIO247_IMAGES_DIR=/images
RADIO247_CACHE_DIR=/cache
RADIO247_DATA_DIR=/data
RADIO247_OUTPUT_DIR=/output
RADIO247_RUNTIME_DIR=/run/radio247

# Admin/internal secrets are generated as files on first startup.
RADIO247_ADMIN_PASSWORD_FILE=/data/secrets/admin-password
RADIO247_INTERNAL_TOKEN_FILE=/data/secrets/internal-token

# YouTube RTMPS (encrypted RTMP). Set STREAM_KEY to your private stream key.
# A missing key is an error, not an automatic fallback to local output.
# STREAM_KEY must contain at least 12 characters. Protect .env; never commit it.
# STREAM_KEY_FILE is no longer supported; no key file is read.
# Set INGEST_URL empty explicitly for local FLV output without external streaming.
RADIO247_INGEST_URL=rtmps://a.rtmps.youtube.com/live2
RADIO247_STREAM_KEY=
# Initializes a NEW database only; subsequent start/stop state is persistent.
RADIO247_AUTOSTART=true
# Optional absolute container path such as /images/default.png; empty = black.
RADIO247_DEFAULT_IMAGE=
# When to show DEFAULT_IMAGE: start / end / both / middle / interval / always / random / none.
# Also adjustable at runtime from the web UI (the UI value overrides this one).
RADIO247_DEFAULT_IMAGE_POSITION=end
# Seconds; 0 disables timed pictures. Disabled when DEFAULT_IMAGE is empty.
RADIO247_DEFAULT_IMAGE_SECONDS=30
# interval mode only: show for SECONDS out of every INTERVAL seconds (must exceed SECONDS).
RADIO247_DEFAULT_IMAGE_INTERVAL=120

# Audio: samples/second (44100 or 48000), channels (1 or 2), bits/second.
RADIO247_SAMPLE_RATE=44100
RADIO247_CHANNELS=2
RADIO247_AUDIO_BITRATE=192000
# Loudness LUFS, true-peak target dBTP, loudness range, fade milliseconds.
RADIO247_TARGET_LUFS=-16
RADIO247_TARGET_PEAK=-2
RADIO247_TARGET_LRA=11
RADIO247_FADE_MS=30

# Pictures are encoded ONCE into reusable H.264/MP4 closed-GOP caches.
# Video dimensions must be even. FPS: 1,24,25,30,50,60. GOP_SECONDS: 1..4.
# FPS=1 is experimental for YouTube. Reduce VIDEO_BITRATE to save bandwidth;
# lowering FPS alone does not proportionally reduce CBR traffic.
RADIO247_WIDTH=1920
RADIO247_HEIGHT=1080
RADIO247_FPS=30
RADIO247_GOP_SECONDS=2
# Bitrate in bits/second; buffer size in bits.
RADIO247_VIDEO_BITRATE=5000000
RADIO247_VIDEO_BUFFER_SIZE=10000000
RADIO247_VIDEO_PRESET=veryfast

# Preparation is sequential. THREADS limits each FFmpeg operation.
RADIO247_FFMPEG=ffmpeg
RADIO247_FFPROBE=ffprobe
RADIO247_THREADS=1
# Timeouts / intervals below are in seconds.
RADIO247_PREPARE_TIMEOUT=3600
RADIO247_PROBE_TIMEOUT=30
RADIO247_SCAN_INTERVAL=5
RADIO247_FILE_STABLE_SECONDS=2
# Cache includes small audio analysis JSON and picture MP4 files, not full PCM.
# No automatic LRU; old PCM files from earlier versions still consume disk space.
RADIO247_CACHE_MAX_BYTES=5000000000
RADIO247_UPLOAD_MAX_BYTES=536870912
# ZIP: total uncompressed bytes and archive entries (including directories).
# Each extracted media file also obeys UPLOAD_MAX_BYTES.
RADIO247_ZIP_MAX_BYTES=1073741824
RADIO247_ZIP_MAX_FILES=1000
RADIO247_IMAGE_MAX_PIXELS=20000000

# Control API / output watchdog / reconnection.
RADIO247_POLL_INTERVAL=1
RADIO247_REQUEST_TIMEOUT=5
RADIO247_CONNECT_TIMEOUT=15
RADIO247_STALL_TIMEOUT=10
RADIO247_RETRY_INITIAL=1
RADIO247_RETRY_MAX=30
RADIO247_RETRY_RESET_SECONDS=60
# Fraction in [0,1], not seconds.
RADIO247_RETRY_JITTER_RATIO=0.2
RADIO247_QUEUE_SECONDS=3
# Original audio is decoded live; bounded in-memory PCM only, no full PCM cache.
RADIO247_DECODE_BUFFER_SECONDS=2
RADIO247_DECODE_TIMEOUT=15

# In-container supervisor: restart the container on service failure or stall.
RADIO247_SERVICE_START_TIMEOUT=60
RADIO247_SERVICE_STALL_TIMEOUT=30

# Local-only FLV rotation; no periodic reconnection in YouTube mode.
RADIO247_LOCAL_SEGMENT_SECONDS=300
RADIO247_LOCAL_KEEP_SEGMENTS=3
RADIO247_UI_POLL_SECONDS=2
RADIO247_LOG_LEVEL=INFO
RADIO247_LOG_MAX_SIZE=10m
RADIO247_LOG_MAX_FILES=3
RADIO247_HEALTH_INTERVAL=10s
RADIO247_HEALTH_TIMEOUT=10s
RADIO247_HEALTH_RETRIES=3
RADIO247_HEALTH_START_PERIOD=30s
